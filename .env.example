# Copiar a .env.local y llenar.

# Replicate — genera las capas de imagen (protagonista y fondo). Obligatorio.
REPLICATE_API_TOKEN=

# Driver de persistencia: fs (default, local) | memory (Vercel sin Supabase) | supabase
STORE_DRIVER=fs

# Supabase — SOLO cuando el admin haya creado buckets y tablas (ver TODO.md).
# Valores en: https://supabase.com/dashboard/project/kuiotuomibomlkxrnifc/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (server-only, nunca NEXT_PUBLIC_). La usa el supabaseDriver para escribir en Storage.
SUPABASE_SECRET_KEY=

# Ruta a Chrome para scripts/render.mjs (batch). Default: Chrome de macOS.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
